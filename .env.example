# JauMemory MCP Server configuration
#
# Every variable listed here is read by the current code (doc-lint
# enforced). Authentication happens through the mcp_login and
# mcp_authenticate tools — no credentials belong in this file.

# API base URL. https:// required (http:// allowed only for localhost
# development). Default: https://mem.jau.app
JAUMEMORY_API_URL=https://mem.jau.app

# gRPC target. Must pair with the API issuer: production API only with
# mem.jau.app:50051; a localhost API only with a loopback target.
JAUMEMORY_GRPC_URL=mem.jau.app:50051

# gRPC TLS is ON by default. Setting false is refused unless the gRPC
# target is loopback.
# JAUMEMORY_GRPC_USE_TLS=true

# Optional cert pinning: hex SHA-256 fingerprint of an expected cert in
# the verified chain. Unset = system-CA verification.
# JAUMEMORY_GRPC_PINNED_SHA256=

# MCP server identity as reported to the MCP client.
MCP_SERVER_NAME=jaumemory
MCP_SERVER_VERSION=0.5.2

# Tool loading mode: flat (default) or categorized.
# MCP_TOOL_LOADING=flat

# Logging: error | warn | info | debug
LOG_LEVEL=info
