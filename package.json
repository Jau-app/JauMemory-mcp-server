{
  "name": "@jaumemory/mcp-server",
  "version": "0.5.2",
  "description": "MCP server providing persistent memory capabilities for AI assistants like Claude",
  "main": "dist/index.js",
  "type": "module",
  "files": [
    "dist",
    "!dist/**/*.map",
    "proto",
    ".env.example"
  ],
  "bin": {
    "jaumemory-mcp-server": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "uninstall": "tsx src/uninstall.ts",
    "verify:windows-acl": "node scripts/verify-windows-acl.mjs",
    "verify:pack": "node scripts/verify-pack.mjs",
    "prepublishOnly": "npm run build && npm run lint && npm test && npm run verify:pack"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.19.0",
    "dotenv": "^16.5.0",
    "google-protobuf": "^3.21.4",
    "winston": "^3.17.0",
    "zod": "^3.25.56"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "^1.1.6"
  },
  "devDependencies": {
    "@types/google-protobuf": "^3.15.12",
    "@types/node": "^22.12.0",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.4",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jau-app/jaumemory-mcp-server.git"
  },
  "keywords": [
    "mcp",
    "claude",
    "jaumemory",
    "ai",
    "memory"
  ],
  "author": "Jau-app",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Jau-app/jaumemory-mcp-server/issues"
  },
  "homepage": "https://github.com/Jau-app/jaumemory-mcp-server#readme"
}
